# Copy to backend/.env for local API development.
# The root Docker Compose configuration exposes PostgreSQL on localhost:5433.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/care_india
AGENCY_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173

# Local development: apply pending database migrations when the backend starts, instead of
# stopping with 'database needs an update'. Safe for a database only you use. If a deployed
# CRM shares the same database, leave this off and run 'npm run db:migrate' as part of a
# release, then deploy the matching version (an upgraded database makes an older deployed
# copy answer 'update required'). A database that is ahead of this code is never touched.
CRM_AUTO_MIGRATE=false

# Optional Veris OCR. Leave blank to enter candidate details manually.
VERIS_OCR_BASE_URL=
VERIS_OCR_API_KEY=

# Read document content locally before sending selected pages to Veris.
# Tesseract is discovered automatically on PATH / its usual Windows install.
# For a custom Windows installation: TESSERACT_CMD=C:/tools/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=
OCR_LANGUAGES=eng
OCR_MAX_PAGES=300
OCR_PAGE_TIMEOUT_SECONDS=20
OCR_DOCUMENT_TIMEOUT_SECONDS=600

# Email receipt/extraction workers. Saved-intake acknowledgements are off until an Admin
# previews and enables them per mailbox in the CRM; explicit replies remain separate.
# Apply migrations, set MAIL_TOKEN_ENCRYPTION_KEY, then connect mailboxes inside Inbox as Admin.
# Any number of Gmail, Microsoft 365, Zoho and IMAP/SMTP mailboxes can be connected.
EMAIL_INGESTION_ENABLED=false
EMAIL_POLL_SECONDS=120
# Optional legacy server configuration. Prefer the encrypted in-app connection form.
IMAP_SERVER=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX
# Optional multiple accounts; replaces the single IMAP_* account when set.
# EMAIL_ACCOUNTS_JSON=[{"host":"imappro.zoho.in","port":993,"username":"cv@example.com","password":"replace-with-app-password","folder":"INBOX","use_ssl":true,"smtp_host":"smtppro.zoho.in","smtp_port":465,"smtp_use_ssl":true}]

# STATIC_DIR defaults to backend/static; STORAGE_DIR to backend/data/uploads.
# Override with absolute paths when using a different local deployment layout.
# Accounts and passwords are managed through the backend CLI, never seeded at startup.
# See README.md for account provisioning and the root .env.example for Compose.

# Optional Redis. Blank disables the connection.
# Local Compose Redis: redis://:<URL-encoded-password>@127.0.0.1:6380/0
# Dokploy: use the Redis service's internal URL when both services share a network.
# URL-encode any reserved characters in the username or password.
REDIS_URL=

# Mailbox credential encryption (passwords and OAuth grants). Generate a Fernet key once,
# store it securely and back it up. See docs/email-connections.md.
MAIL_TOKEN_ENCRYPTION_KEY=
SMTP_SERVER=
SMTP_PORT=587
SMTP_USE_SSL=false

# Where users open the CRM. Only needed when the browser app is served from a different
# origin than the API (local development: http://localhost:5173); blank in production.
APP_BASE_URL=

# Gmail sign-in (Google Cloud OAuth client, type "Web application", Gmail IMAP/SMTP scope).
# Authorized redirect URI: https://<crm-host>/api/inbox/oauth/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# Microsoft 365 sign-in (Entra app registration, delegated IMAP.AccessAsUser.All + SMTP.Send,
# offline_access). Redirect URI: https://<crm-host>/api/inbox/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT=common

# WhatsApp Business Cloud API. Use the supported version configured in your Meta app.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
# Required to sync and re-validate approved outbound templates.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Private document storage. Switching this setting does not copy existing documents.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=crm
