# Copy to backend/.env for local API development.
# The root Docker Compose configuration exposes PostgreSQL on localhost:5433.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/care_india
AGENCY_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173

# Optional Veris OCR. Leave blank to enter candidate details manually.
VERIS_OCR_BASE_URL=
VERIS_OCR_API_KEY=

# STATIC_DIR defaults to backend/static; STORAGE_DIR to backend/data/uploads.
# Override with absolute paths when using a different local deployment layout.
# Accounts and passwords are managed through the backend CLI, never seeded at startup.
# See README.md for account provisioning and the root .env.example for Compose.
