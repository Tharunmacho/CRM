# Docker Compose local development settings. Copy to .env at the project root.
# The Python development server reads backend/.env instead.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=care_india
# App connection inside Compose. If changing the DB credentials/name above, update
# this URL too. Percent-encode URL username/password characters such as @, : and /.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/care_india
POSTGRES_PORT=5433
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
AGENCY_TIMEZONE=Asia/Kolkata

# Optional local Redis: docker compose --profile redis up -d redis
# Generate a password before starting Redis, for example:
# python -c "import secrets; print(secrets.token_hex(32))"
# Leaving REDIS_PASSWORD blank keeps unrelated Compose commands usable, but the
# Redis service itself refuses to start without a password.
REDIS_PASSWORD=
REDIS_PORT=6380
# For the app inside Compose, set redis://:<password>@redis:6379/0 here.
# For the host Python server, set REDIS_URL in backend/.env instead:
# redis://:<password>@127.0.0.1:6380/0 (use REDIS_PORT if changed).
# URL-encode reserved characters in the password. Blank disables app integration.
REDIS_URL=

# Optional: the manual candidate form works without the OCR service.
VERIS_OCR_BASE_URL=
VERIS_OCR_API_KEY=

# Local document inspection inside the Linux container. Leave TESSERACT_CMD blank
# to use the installed executable; a Windows host path cannot be used here.
TESSERACT_CMD=
OCR_LANGUAGES=eng
OCR_MAX_PAGES=300
OCR_PAGE_TIMEOUT_SECONDS=20
OCR_DOCUMENT_TIMEOUT_SECONDS=600
# Reading queue: documents are read side by side. Documents read at once = EXTRACTION_WORKERS (processes)
# x EXTRACTION_CONCURRENCY (threads each); the product is capped by EXTRACTION_MAX_PARALLEL (default 16).
# Defaults: 1 worker process with 8 threads per queue. Parallelism comes from threads; on a hosted database every extra
# process adds its own polling, so raise EXTRACTION_WORKERS only when one process is the bottleneck.
# EXTRACTION_CONCURRENCY=8
# EXTRACTION_WORKERS=1
# EXTRACTION_MAX_PARALLEL=16
# EXTRACTION_LEASE_SECONDS=180
# EXTRACTION_SHUTDOWN_SECONDS=30

# Incoming email only. Enable the container's separate worker, then connect the
# configured mailbox in Inbox. No automatic replies, moving or deletion.
EMAIL_INGESTION_ENABLED=false
EMAIL_POLL_SECONDS=120
IMAP_SERVER=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX
# Optional multiple mailboxes; replaces the single IMAP_* account when set.
# EMAIL_ACCOUNTS_JSON='[{"host":"imap.example.com","port":993,"username":"cv@example.com","password":"replace-with-app-password","folder":"INBOX","use_ssl":true}]'
EMAIL_ACCOUNTS_JSON=
# API and worker share the Compose uploads volume. A deployment handoff must copy
# all files and the hidden .email-storage-id marker; see the README.

# User accounts are provisioned explicitly with the backend CLI; see README.md.
# These database defaults are for local development only.
# Use deployment-managed credentials and persistent database/uploads volumes in production.

# Names this installation in the shared queue tables (document_extraction_jobs.instance). Leave blank to use the host
# name plus a hash of the storage location. Set it when two installations share one database but keep their files apart.
# INSTANCE_NAME=
