# Docker Compose local development settings. Copy to .env at the project root.
# The Python development server reads backend/.env instead.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=care_india
# App connection inside Compose. If changing the DB credentials/name above, update
# this URL too. Percent-encode URL username/password characters such as @, : and /.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/care_india
POSTGRES_PORT=5433
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
AGENCY_TIMEZONE=Asia/Kolkata

# Optional local Redis: docker compose --profile redis up -d redis
# Generate a password before starting Redis, for example:
# python -c "import secrets; print(secrets.token_hex(32))"
# Leaving REDIS_PASSWORD blank keeps unrelated Compose commands usable, but the
# Redis service itself refuses to start without a password.
REDIS_PASSWORD=
REDIS_PORT=6380
# For the app inside Compose, set redis://:<password>@redis:6379/0 here.
# For the host Python server, set REDIS_URL in backend/.env instead:
# redis://:<password>@127.0.0.1:6380/0 (use REDIS_PORT if changed).
# URL-encode reserved characters in the password. Blank disables app integration.
REDIS_URL=

# Optional: the manual candidate form works without the OCR service.
VERIS_OCR_BASE_URL=
VERIS_OCR_API_KEY=

# User accounts are provisioned explicitly with the backend CLI; see README.md.
# These database defaults are for local development only.
# Use deployment-managed credentials and persistent database/uploads volumes in production.
